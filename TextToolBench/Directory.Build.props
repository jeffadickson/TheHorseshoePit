<Project>
  <!-- Overview is referenced alongside SedBench in the tests. Isolate its generated
       assembly/apphost and restore state so independent project builds cannot race. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Overview'">
    <BaseIntermediateOutputPath>obj/Overview/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DiffBench'">
    <BaseIntermediateOutputPath>obj/DiffBench/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
